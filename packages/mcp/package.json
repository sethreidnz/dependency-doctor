{
  "name": "@dependency-doctor/mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for interactive dependency upgrade workflows",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:mcp && npm run build:cli",
    "build:mcp": "xmcp build",
    "build:cli": "tsc",
    "dev": "xmcp dev",
    "start": "node dist/stdio.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.20.5",
    "tsyringe": "^4.8.0",
    "xmcp": "^0.2.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "swc-loader": "^0.2.6"
  },
  "main": "./dist/stdio.js",
  "files": [
    "dist"
  ],
  "bin": {
    "dependency-doctor": "./dist/cli.js"
  }
}
